# ─────────────────────────────────────────────────────────────
# AI Trading Signal Intelligence - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Demo Mode ─────────────────────────────────────────────────
# Set to true to enable demo mode (judge demo panel active)
# Demo mode DOES NOT fake blockchain - all txs are real
DEMO_MODE=true

# ── Symbols to track ─────────────────────────────────────────
SYMBOLS=BTC/USDT,ETH/USDT

# ── Market Scan ──────────────────────────────────────────────
# How often to scan for new signals (milliseconds)
# Default: 300000 (5 minutes)
SCAN_INTERVAL_MS=300000

# ── Algorand ─────────────────────────────────────────────────
ALGORAND_NETWORK=testnet
ALGORAND_APP_ID=1008

# Mnemonic for the deployer/transaction account
# Required for blockchain registration
# Get testnet ALGOs from: https://dispenser.testnet.aws.algodev.network/
ALGORAND_MNEMONIC=

# ── Telegram Bot ─────────────────────────────────────────────
# Create your bot: https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Optional: broadcast to a channel (format: @channelname or -100xxxxxxxxxx)
TELEGRAM_CHANNEL_ID=

# ── Market Data ───────────────────────────────────────────────
# Binance public API - no key required for basic usage
# Set if you have a Binance API key for higher rate limits
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── AI Features (Optional) ───────────────────────────────────
# For AI-generated signal explanations
AI_API_KEY=

# ── Database ─────────────────────────────────────────────────
# SQLite database is stored in backend/data/signals.db
# No configuration required for local development
GEMINI_API_KEY=YOUR_API_KEY_HERE
